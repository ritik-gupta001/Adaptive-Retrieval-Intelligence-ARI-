# ARI Platform — Environment Configuration Example
# Copy this file to .env and fill in your secrets/configurations:
#   cp .env.example .env

# --- Environment ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
VECTOR_STORE=chroma
CHROMA_DIR=./data/chroma
FAISS_INDEX_PATH=./data/faiss_index
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=ari_default

# --- Reranking ---
RERANKER_PROVIDER=none
COHERE_API_KEY=
BGE_MODEL_NAME=BAAI/bge-reranker-base

# --- Web search ---
TAVILY_API_KEY=

# --- Graph RAG (optional) ---
GRAPH_RAG_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Retrieval tuning ---
TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
MULTI_QUERY_N=4
DOCUMENT_REFERENCE_KEYWORDS=resume,cv,pdf,txt,file,document,uploaded

# --- Reflection / confidence loop ---
CONFIDENCE_THRESHOLD=0.7
HALLUCINATION_RISK_THRESHOLD=0.3
MAX_RETRIES=2

# --- Memory ---
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_CONN_STR=
STORE_BACKEND=memory

# --- Observability ---
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ari-platform

# --- Evaluation ---
EVAL_FRAMEWORK=both

# --- LLM runtime tuning ---
LLM_CLIENT_TIMEOUT=12.0
LLM_CLIENT_MAX_RETRIES=1
LLM_CLASSIFICATION_TIMEOUT=10.0

# --- Fallback models (used when not the primary provider) ---
OPENAI_FALLBACK_MODEL=gpt-4o-mini
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
ANTHROPIC_FALLBACK_MODEL=claude-3-5-sonnet-20241022
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# --- Token budgets per node ---
MAX_TOKENS_CLASSIFICATION=256
MAX_TOKENS_VALIDATION=300
MAX_TOKENS_REFLECTION=400
MAX_TOKENS_GENERATION=1500

# --- Document truncation per node ---
MAX_DOC_CHARS_GENERATION=2500
MAX_DOC_CHARS_REFLECTION=1000
MAX_DOC_CHARS_VALIDATION=600

# --- Confidence scoring ---
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.5
WEB_SEARCH_CONFIDENCE_CAP=0.72
CONFIDENCE_WEIGHT_REFLECTION=0.35
CONFIDENCE_WEIGHT_RETRIEVAL=0.30
CONFIDENCE_WEIGHT_HALLUCINATION=0.25
CONFIDENCE_WEIGHT_CITATION=0.10

# --- Memory ---
MEMORY_HISTORY_TURNS=5
MEMORY_ANSWER_PREVIEW_CHARS=300

# --- File upload processing ---
UPLOAD_CHUNK_SIZE=500
UPLOAD_CHUNK_OVERLAP=50
UPLOADED_FILE_EXTENSIONS=.pdf,.txt,.doc,.docx,.csv,.md

# --- Graph execution ---
GRAPH_RECURSION_LIMIT=50
